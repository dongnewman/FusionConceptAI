{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "UP1.authority-intake-envelope.v1",
  "title": "UP1 offline authority intake envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sender_id", "authority_channel_id", "nonce", "sequence", "idempotency_key", "payload"],
  "properties": {
    "schema_version": {"const": "UP1.authority-intake-envelope.v1"},
    "sender_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$"},
    "authority_channel_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$"},
    "payload": {},
    "external_signature": {"description": "Opaque input only; never verified or trusted by this adapter."}
  }
}

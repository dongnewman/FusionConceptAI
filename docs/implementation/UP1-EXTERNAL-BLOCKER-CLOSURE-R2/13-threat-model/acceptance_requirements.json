{
  "schema": "UP1.external-blocker-closure-r2.acceptance-requirements.v1",
  "revision": "W2-R2-13",
  "status": "pass_limited",
  "verdict_enum": ["pass_limited", "rework", "block_external"],
  "claim_ceiling": "preparation_only",
  "no_authority_credit": true,
  "no_publish": true,
  "evidence_state_semantics": {"program_exception":"Independent unexpected runtime/tool evidence state; it is not fail_closed and not typed_absence/terminal_deferred. Preserve raw evidence and classify the package as rework or block_external; never promote it to pass.","typed_absence":"External fact unavailable with accountable recovery metadata; only terminal_deferred and no_publish.","fail_closed":"Observed contradiction/tamper/policy violation; never downgrade to deferred."},
  "acceptance_rule": "All mandatory requirements and all negative attacks must pass in a fresh independent process before any external fact can be considered for a future bounded recheck. This package itself does not perform that recheck.",
  "requirements": [
    {"id":"AR-01","title":"Strict schema and duplicate-key parsing","mandatory":true,"components":["W2-trust-chain","W3-source-g2-environment","R2-14-review-protocol"],"must_prove":["UTF-8 deterministic canonical bytes","duplicate keys rejected","unknown fields rejected or explicitly versioned","non-finite numbers rejected","digest is over exact bytes"],"negative_attacks":["TM-15","TM-20"],"evidence":["raw input bytes","canonical bytes","parser stderr/stdout","exit code","SHA-256"],"failure":"fail_closed"},
    {"id":"AR-02","title":"Independent identity and trust path","mandatory":true,"components":["W1-witness-authority","W2-trust-chain"],"must_prove":["external pinned root","full chain and issuer linkage","leaf CA=false and digitalSignature","declared EKU/policy/name constraints","independence and conflict boundary"],"negative_attacks":["TM-01","TM-05","TM-06"],"evidence":["certificate fingerprints","root source record","path validator raw","policy/profile version"],"failure":"fail_closed"},
    {"id":"AR-03","title":"Candidate and source byte identity","mandatory":true,"components":["W1-witness-authority","W2-trust-chain","W3-source-g2-environment","candidate-lineage"],"must_prove":["candidate id/version/digest bound","source path, HEAD OID, working hash and dirty executor distinguished","signed source-version inventory","both source->candidate and candidate->source edges agree"],"negative_attacks":["TM-02","TM-03","TM-20"],"evidence":["source inventory","candidate receipt","recomputed hashes/OIDs","scope check"],"failure":"fail_closed"},
    {"id":"AR-04","title":"G1/G2/G3 and four-axis binding","mandatory":true,"components":["W1-witness-authority","W3-source-g2-environment","candidate-lineage"],"must_prove":["exact layer and axis identifiers","all four axes present where contract requires","no cross-candidate references","G2 mapping includes namespace/version/effective interval/issuer/signature/revocation/anti-replay"],"negative_attacks":["TM-04"],"evidence":["four-axis inventory","G2 mapping","bidirectional edge report","canonical digest"],"failure":"fail_closed"},
    {"id":"AR-05","title":"Revocation and trusted time","mandatory":true,"components":["W2-trust-chain","W1-witness-authority"],"must_prove":["issuer/serial-bound fresh CRL or OCSP","revoked/invalid/expired is fail-closed","unavailable is typed_absence terminal_deferred","independent signed time token binds receipt digest and nonce","OS/file/Git/runner time is observation only"],"negative_attacks":["TM-07","TM-08"],"evidence":["raw CRL/OCSP","TSA token","as-of/freshness calculation","UTC","verifier exit/hash"],"failure":"fail_closed_or_terminal_deferred_by_cause"},
    {"id":"AR-06","title":"Replay and retry safety","mandatory":true,"components":["W1-witness-authority","W2-trust-chain"],"must_prove":["nonce/challenge unique per scope/window","sequence monotone per scope","idempotency key is bound to canonical digest","same key+same bytes is idempotent only","same key+changed bytes conflicts","replay ledger retention and trusted-time basis declared"],"negative_attacks":["TM-09","TM-10","TM-11"],"evidence":["request ledger","raw ack","nonce/sequence/key","replay-window policy","PID/exit"],"failure":"fail_closed_or_terminal_deferred_if_ledger_unavailable"},
    {"id":"AR-07","title":"Atomic file identity and path containment","mandatory":true,"components":["W3-source-g2-environment","W4-local-input-discovery","R2-06-environment-provenance","R2-09-local-discovery"],"must_prove":["hash bytes actually opened/used","detect replacement between check and use","reject symlink/junction/reparse components","normalized path remains under declared root","case/separator/traversal aliases cannot escape"],"negative_attacks":["TM-12","TM-13"],"evidence":["pre/post file identity","resolved path","root containment result","raw validator","SHA-256"],"failure":"fail_closed"},
    {"id":"AR-08","title":"Acyclic exact manifest closure","mandatory":true,"components":["W3-source-g2-environment","W4-local-input-discovery","R2-06-environment-provenance","R2-14-review-protocol"],"must_prove":["owned path exact set","manifest and cleanup self-hash exclusions explicit","no unlisted or omitted artifact","independent recomputation agrees","failure artifacts retained"],"negative_attacks":["TM-14"],"evidence":["manifest preimage","hash map","cleanup inventory","path count","independent process exit/hash"],"failure":"fail_closed","TM14_oracle":{"manifest_omission":"fail_closed","manifest_hash_mismatch":"fail_closed","manifest_extra":"fail_closed","manifest_self_reference":"fail_closed","external_required_receipt_unavailable":"typed_absence -> terminal_deferred only"}},
    {"id":"AR-09","title":"Complete environment, import and SBOM closure","mandatory":true,"components":["W3-source-g2-environment","R2-06-environment-provenance","R2-10-environment-capture"],"must_prove":["OS/architecture/runtime paths and hashes","package locks and hashes","import/module/package/artifact sets","SBOM digest and transitive closure","license closure","candidate-bound signed external provenance"],"negative_attacks":["TM-16","TM-18"],"evidence":["clean-process import replay","runtime/lock hashes","SBOM/license records","environment digest","UTC/PID/exit"],"failure":"fail_closed_or_terminal_deferred_if_provider_missing"},
    {"id":"AR-10","title":"Binary provenance and substitution resistance","mandatory":true,"components":["W3-source-g2-environment","R2-06-environment-provenance","R2-10-environment-capture"],"must_prove":["binary name/version/path/sha256","publisher signature and origin","build recipe","SBOM and license linkage","opened executable hash equals receipt","PATH/cache ambiguity ruled out"],"negative_attacks":["TM-17"],"evidence":["binary hash","signature verification","origin/build receipt","SBOM","process invocation raw"],"failure":"fail_closed_or_terminal_deferred_if_provenance_missing"},
    {"id":"AR-11","title":"Typed absence is a non-passing terminal state","mandatory":true,"components":["W1-witness-authority","W2-trust-chain","W3-source-g2-environment","W4-local-input-discovery","R2-14-review-protocol"],"must_prove":["closed decision enum","each absence has owner/source/recovery/expiry/validation","null/empty/placeholder/local hash/runner exit cannot stand in","unavailable maps to terminal_deferred","contradiction maps to fail_closed","no authority or formal credit emitted"],"negative_attacks":["TM-19"],"evidence":["absence ledger","negative fixture outputs","claim ceiling","no_publish flag","validator exit/hash"],"failure":"fail_closed_for_false_promotion"},
    {"id":"AR-12","title":"Independent replay and review evidence","mandatory":true,"components":["R2-14-review-protocol","W1-witness-authority","W2-trust-chain","W3-source-g2-environment"],"must_prove":["fresh Python -B process","independent reviewer is distinct from implementer","raw stdout/stderr preserved","PID/UTC/exit captured","product and input SHA-256 recorded","dirty worktree boundary checked","claim ceiling and write scope checked"],"negative_attacks":["TM-01","TM-03","TM-14","TM-19"],"evidence":["review report","run ledger","raw files","process receipt","hash manifest"],"failure":"fail_closed"}
  ],
  "global_gates": [
    {"id":"GATE-THREAT-COVERAGE","rule":"TM-01 through TM-20 each have a matrix row, component, oracle, evidence and explicit outcome."},
    {"id":"GATE-NO-UNSAFE-DOWNGRADE","rule":"No fail_closed contradiction may become terminal_deferred; no typed_absence/unavailable may become pass."},
    {"id":"GATE-NO-CREDIT","rule":"Preparation artifacts, tests, local observations, fixtures, historical records and this threat model grant zero external/UP1/B00/B04/R01-R10/L4 credit."},
    {"id":"GATE-RETRY","rule":"No duplicate AD or blind retry when upstream input fingerprint is unchanged."}
  ]
}

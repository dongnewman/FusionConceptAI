{
  "schema": "UP1-R2.source-axis-binding.contract.v1",
  "axes": [
    "payload_schema_version",
    "canonicalization_profile_version",
    "applicability_profile_version",
    "evidence_receipt_version"
  ],
  "source_identity_required": [
    "head",
    "head_tree",
    "dirty_status_digest",
    "patch_digest",
    "untracked_files",
    "untracked_content_digest",
    "submodule_closure",
    "source_identity_digest"
  ],
  "immutable_digest_excludes": ["source_identity_digest", "axis_edges", "candidate_axis_edges"],
  "material_digest_excludes": ["digest", "material_digest", "source_edge", "candidate_edge"],
  "edge_rule": "source and candidate reverse edges are exact canonical objects containing axis, candidate_id, source_identity_digest, material_digest, namespace, version, issuer and issued_at",
  "failure_codes": [
    "missing_axis",
    "duplicate_axis",
    "unknown_axis",
    "hash_mismatch",
    "source_drift",
    "source_edge_mismatch",
    "candidate_edge_mismatch",
    "source_edge_missing_or_ambiguous",
    "candidate_edge_missing_or_ambiguous",
    "foreign_candidate"
  ],
  "absence": {
    "state": "typed_absence",
    "admission": "terminal_deferred",
    "authority_evidence": false
  },
  "test_only": {
    "status": "TEST_ONLY",
    "classification": "non_evidence",
    "authority_evidence": false
  },
  "ad56": "software_bookkeeping_only; never authority evidence",
  "observed_source": "required and exact immutable-fact match; missing or stale observation is fail_closed",
  "external_authority_required": ["signature_validated", "trust_root_validated", "trusted_time_validated", "revocation_validated", "g2_mapping_validated"],
  "strict_schema": true,
  "duplicate_json_keys": "reject before parsing",
  "determinism": "sort all errors by path, code and message before receipt serialization",
  "closed_enums": {
    "identity_schema_version": ["UP1-R2.source-identity.v1"],
    "state": ["TEST_ONLY", "typed_absence", "EXTERNAL_ISSUED"],
    "provenance_class": ["test_fixture", "external_material_absent", "external_issued"]
  },
  "authority_output_rule": "authority_evidence=true only when valid=true, state=EXTERNAL_ISSUED, provenance_class=external_issued and all prerequisites validate; fail_closed/typed_absence always false",
  "nested_allowlists": ["submodule_closure", "untracked_files records", "ad56", "authority", "source_axis_edges", "candidate_axis_edges", "payload"]
}

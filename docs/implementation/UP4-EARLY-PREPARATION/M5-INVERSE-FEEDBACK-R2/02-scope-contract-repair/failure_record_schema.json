{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.invalid/m5-inverse-feedback-r2/failure-record.schema.json",
  "title": "EngineeringFeedbackFailureRecordV2Repair",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "class", "path", "detail", "resolution", "claim_ceiling", "raw_context"],
  "properties": {
    "code": {"enum": ["invalid_input", "invalid_upstream", "candidate_unbound", "source_unbound", "scenario_unbound", "foreign_hash", "foreign_owner", "foreign_provenance", "schema_mismatch", "unit_or_direction_mismatch", "target_invalid", "nonidentifiable_target", "singular", "non_spd", "impossible_target", "roundtrip", "seed_mismatch", "feedback_deletion_no_effect", "numerical_nonfinite", "numerical_fail", "budget_exhausted", "provider_unavailable", "out_of_domain", "real_reference_missing", "hardware_authority_missing", "solver_not_authorized", "program_exception", "human_interruption", "unknown"]},
    "class": {"enum": ["contract", "authority", "provenance", "fixture", "determinism", "causal_negative", "numerical", "execution", "external_authority", "scope", "evidence"]},
    "path": {"type": "string", "pattern": "^(/[A-Za-z0-9._~-]+)+$"},
    "detail": {"type": "string", "minLength": 1, "maxLength": 1024},
    "resolution": {"enum": ["fail_closed", "unknown+terminal_deferred", "typed_failure", "preserve_raw"]},
    "claim_ceiling": {"const": "manufactured_inverse_feedback/screen_only"},
    "raw_context": {"type": "object", "additionalProperties": false, "required": ["pid", "utc", "exit_code", "stdout_raw", "stderr_raw"], "properties": {"pid": {"type": ["integer", "null"], "minimum": 0}, "utc": {"type": ["string", "null"], "format": "date-time"}, "exit_code": {"type": ["integer", "string", "null"]}, "stdout_raw": {"type": ["string", "null"]}, "stderr_raw": {"type": ["string", "null"]}}}
  }
}

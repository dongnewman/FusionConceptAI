{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.invalid/m5-inverse-feedback-r2/failure-taxonomy.json",
  "title": "EngineeringFeedbackFailureTaxonomyV2Repair",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "claim_ceiling", "record_schema", "rules", "codes"],
  "properties": {
    "schema": {"const": "EngineeringFeedbackFailureTaxonomyV2Repair"},
    "claim_ceiling": {"const": "manufactured_inverse_feedback/screen_only"},
    "record_schema": {"const": "failure_record_schema.json"},
    "rules": {"type": "object", "additionalProperties": false, "required": ["missing_authority", "contradiction_or_foreign_identity", "numerical_fixture_failure", "runtime_exception_or_interruption"], "properties": {"missing_authority": {"const": "unknown+terminal_deferred"}, "contradiction_or_foreign_identity": {"const": "fail_closed"}, "numerical_fixture_failure": {"const": "typed_failure"}, "runtime_exception_or_interruption": {"const": "preserve_raw"}}},
    "codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["code", "class", "resolution"], "properties": {"code": {"type": "string", "minLength": 1}, "class": {"type": "string", "minLength": 1}, "resolution": {"enum": ["fail_closed", "unknown+terminal_deferred", "typed_failure", "preserve_raw"]}}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.invalid/m5-inverse-feedback-r2/input.schema.json",
  "title": "EngineeringFeedbackSliceRequestV2Repair",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "claim_ceiling", "formal_credit", "canonical_bundle", "candidate_binding", "upstream", "freeze_gate", "manufactured_case", "objective_and_constraints", "replay", "budget", "evidence_policy"],
  "properties": {
    "schema": {"const": "EngineeringFeedbackSliceRequestV2Repair"},
    "status": {"enum": ["authorized_not_started", "ready"]},
    "claim_ceiling": {"const": "manufactured_inverse_feedback/screen_only"},
    "formal_credit": {"const": "none"},
    "canonical_bundle": {"$ref": "canonical_bundle_schema.json"},
    "candidate_binding": {"$ref": "#/$defs/binding"},
    "upstream": {"$ref": "#/$defs/upstream"},
    "freeze_gate": {"$ref": "#/$defs/freeze_gate"},
    "manufactured_case": {"$ref": "#/$defs/manufactured_case"},
    "objective_and_constraints": {"$ref": "#/$defs/objective"},
    "replay": {"$ref": "#/$defs/replay"},
    "budget": {"$ref": "#/$defs/budget"},
    "evidence_policy": {"$ref": "#/$defs/evidence_policy"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "ready"}}}, "then": {"properties": {"freeze_gate": {"properties": {"current_authority": {"const": "fresh_refreeze_complete"}, "required_before_execution": {"const": "different_role_review_complete"}}}}}}
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "hash_item": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha"}}},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_ref", "g1", "g2", "g3", "parent_baseline", "mission", "scenario", "source"],
      "properties": {
        "candidate_ref": {"$ref": "#/$defs/ref"},
        "g1": {"$ref": "#/$defs/versioned_ref"}, "g2": {"$ref": "#/$defs/versioned_ref"}, "g3": {"$ref": "#/$defs/versioned_ref"},
        "parent_baseline": {"$ref": "#/$defs/versioned_ref"}, "mission": {"$ref": "#/$defs/versioned_ref"}, "scenario": {"$ref": "#/$defs/versioned_ref"},
        "source": {"$ref": "#/$defs/source_ref"}
      }
    },
    "versioned_ref": {"type": "object", "additionalProperties": false, "required": ["ref", "schema", "content_sha256", "body_sha256"], "properties": {"ref": {"$ref": "#/$defs/ref"}, "schema": {"$ref": "#/$defs/ref"}, "content_sha256": {"$ref": "#/$defs/sha"}, "body_sha256": {"$ref": "#/$defs/sha"}}},
    "source_ref": {"type": "object", "additionalProperties": false, "required": ["source_ref", "source_schema", "content_sha256", "owner", "provenance_ref", "provenance_sha256", "applicability_domain"], "properties": {"source_ref": {"$ref": "#/$defs/ref"}, "source_schema": {"$ref": "#/$defs/ref"}, "content_sha256": {"$ref": "#/$defs/sha"}, "owner": {"$ref": "#/$defs/ref"}, "provenance_ref": {"$ref": "#/$defs/ref"}, "provenance_sha256": {"$ref": "#/$defs/sha"}, "applicability_domain": {"const": "manufactured_fixture_only"}}},
    "upstream": {
      "type": "object", "additionalProperties": false,
      "required": ["m4d_snapshot", "m5a_snapshot", "m4d_source", "m4d_test", "m4d_oracle", "m5a_source", "m5a_test", "m5a_oracle", "m5a_composition", "owner_ledger", "provenance_ledger", "derived_bundle_sha256"],
      "properties": {
        "m4d_snapshot": {"$ref": "#/$defs/snapshot"}, "m5a_snapshot": {"$ref": "#/$defs/snapshot"},
        "m4d_source": {"$ref": "#/$defs/hash_item"}, "m4d_test": {"$ref": "#/$defs/hash_item"}, "m4d_oracle": {"$ref": "#/$defs/hash_item"},
        "m5a_source": {"$ref": "#/$defs/hash_item"}, "m5a_test": {"$ref": "#/$defs/hash_item"}, "m5a_oracle": {"$ref": "#/$defs/hash_item"}, "m5a_composition": {"$ref": "#/$defs/hash_item"},
        "owner_ledger": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ledger_item"}},
        "provenance_ledger": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ledger_item"}},
        "derived_bundle_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["snapshot_ref", "schema", "body", "body_sha256"], "properties": {"snapshot_ref": {"$ref": "#/$defs/ref"}, "schema": {"$ref": "#/$defs/ref"}, "body": {"type": "object", "additionalProperties": false, "required": ["snapshot_kind", "snapshot_status", "content_sha256"], "properties": {"snapshot_kind": {"enum": ["M4D_manufactured_snapshot", "M5A_manufactured_snapshot"]}, "snapshot_status": {"const": "frozen_typed_snapshot"}, "content_sha256": {"$ref": "#/$defs/sha"}}}, "body_sha256": {"$ref": "#/$defs/sha"}}},
    "ledger_item": {"type": "object", "additionalProperties": false, "required": ["subject_ref", "owner_ref", "content_sha256", "provenance_ref"], "properties": {"subject_ref": {"$ref": "#/$defs/ref"}, "owner_ref": {"$ref": "#/$defs/ref"}, "content_sha256": {"$ref": "#/$defs/sha"}, "provenance_ref": {"$ref": "#/$defs/ref"}}},
    "freeze_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["historical_scope", "current_authority", "current_byte_relation", "drift_audit_ref", "drift_audit_sha256", "required_before_execution", "source_test_oracle_refreeze"],
      "properties": {
        "historical_scope": {"const": "historical_only"}, "current_authority": {"enum": ["unknown_until_fresh_refreeze", "fresh_refreeze_complete"]}, "current_byte_relation": {"enum": ["drift_from_historical_r1", "byte_equal_to_historical_r1"]},
        "drift_audit_ref": {"$ref": "#/$defs/ref"}, "drift_audit_sha256": {"$ref": "#/$defs/sha"},
        "required_before_execution": {"enum": ["fresh_refreeze_and_isolated_replay_and_different_role_review", "different_role_review_complete"]},
        "source_test_oracle_refreeze": {"const": "all_m5_m5a_source_test_oracle_and_dependency_snapshots"}
      }
    },
    "manufactured_case": {
      "type": "object", "additionalProperties": false,
      "required": ["family_id", "matrix_schema", "rhs", "target", "hidden_parameter_policy", "feedback_edge", "feedback_deletion", "arithmetic_mode"],
      "properties": {
        "family_id": {"const": "M5-INVERSE-FEEDBACK-MANUFACTURED-V1"}, "matrix_schema": {"const": "[[alpha,-beta],[-beta,alpha]]"},
        "rhs": {"const": ["1/1", "0/1"]}, "target": {"const": ["2/3", "1/3"]}, "hidden_parameter_policy": {"const": "oracle_only_withheld_from_seed_initialization_cache_and_held_out"},
        "feedback_edge": {"$ref": "#/$defs/feedback_edge"}, "feedback_deletion": {"$ref": "#/$defs/deletion"}, "arithmetic_mode": {"const": "M4RationalV1_exact"}
      }
    },
    "feedback_edge": {"type": "object", "additionalProperties": false, "required": ["edge_ref", "candidate_ref", "source_ref", "owner_ref", "parameter", "axis", "units", "direction", "effect_scope", "version", "active"], "properties": {"edge_ref": {"$ref": "#/$defs/ref"}, "candidate_ref": {"$ref": "#/$defs/ref"}, "source_ref": {"$ref": "#/$defs/ref"}, "owner_ref": {"$ref": "#/$defs/ref"}, "parameter": {"const": "beta"}, "axis": {"const": "interface_beta"}, "units": {"const": "dimensionless_fixture"}, "direction": {"const": "feedback_to_response"}, "effect_scope": {"const": "manufactured_response_only"}, "version": {"type": "integer", "minimum": 0}, "active": {"const": true}}},
    "deletion": {"type": "object", "additionalProperties": false, "required": ["operation", "expected_version", "actor_ref", "owner_ref", "reason", "history", "cas_policy"], "properties": {"operation": {"const": "delete_beta_or_interface_feedback"}, "expected_version": {"type": "integer", "minimum": 0}, "actor_ref": {"$ref": "#/$defs/ref"}, "owner_ref": {"$ref": "#/$defs/ref"}, "reason": {"const": "pre_registered_causal_negative_control"}, "history": {"type": "array", "maxItems": 0}, "cas_policy": {"const": "compare_version_and_edge_identity_before_append"}}},
    "objective": {"type": "object", "additionalProperties": false, "required": ["terms", "units", "norm", "tolerances", "hard_constraints", "diagnostics"], "properties": {"terms": {"const": ["forward_residual", "inverse_roundtrip_residual", "feedback_delta"]}, "units": {"const": "dimensionless_fixture"}, "norm": {"const": "exact_linf"}, "tolerances": {"const": {"forward_residual": "0/1", "inverse_roundtrip_residual": "0/1", "feedback_delta": "1/6,1/3"}}, "hard_constraints": {"const": ["candidate_source_join", "exact_rational", "feedback_changed" ]}, "diagnostics": {"const": ["determinant", "eigenvalues", "rank", "condition_proxy"]}}},
    "replay": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_serialization", "hash_algorithm", "field_order", "rational_encoding", "seed_order", "locale", "timezone", "environment_fingerprint", "environment_fingerprint_sha256", "oracle_checker_order", "attempt_identity", "max_replays"],
      "properties": {
        "canonical_serialization": {"const": "JCS-UTF8-LF-RATIONAL-SHA256-V1"}, "hash_algorithm": {"const": "SHA-256"}, "field_order": {"const": "lexicographic_unicode_codepoint"}, "rational_encoding": {"const": "reduced_ascii_a_over_b_string_no_float"}, "seed_order": {"const": [0, 1, 2]}, "locale": {"const": "C"}, "timezone": {"const": "UTC"}, "environment_fingerprint": {"$ref": "#/$defs/environment"}, "environment_fingerprint_sha256": {"$ref": "#/$defs/sha"}, "oracle_checker_order": {"const": ["independent_fraction_oracle", "typed_checker"]}, "attempt_identity": {"type": "string", "pattern": "^M5R2-REFREEZE-[0-9]{8}-[0-9]{6}Z$"}, "max_replays": {"const": 2}
      }
    },
    "environment": {"type": "object", "additionalProperties": false, "required": ["os", "architecture", "python_version", "powershell_version", "dependency_lock_sha256", "git_head", "command_profile"], "properties": {"os": {"type": "string", "minLength": 1}, "architecture": {"type": "string", "minLength": 1}, "python_version": {"type": "string", "minLength": 1}, "powershell_version": {"type": "string", "minLength": 1}, "dependency_lock_sha256": {"$ref": "#/$defs/sha"}, "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "command_profile": {"const": "read_only_static_validation_no_runtime"}}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["max_positive_cases", "max_seeds", "max_negative_controls", "max_serial_replays", "processes", "workers", "network", "wall_clock_seconds", "memory_mib", "optimizer", "solver_provider"], "properties": {"max_positive_cases": {"const": 1}, "max_seeds": {"const": 3}, "max_negative_controls": {"const": 24}, "max_serial_replays": {"const": 2}, "processes": {"const": 1}, "workers": {"const": 1}, "network": {"const": "forbidden"}, "wall_clock_seconds": {"const": 120}, "memory_mib": {"const": 512}, "optimizer": {"const": "forbidden"}, "solver_provider": {"const": "forbidden"}}},
    "evidence_policy": {"type": "object", "additionalProperties": false, "required": ["claim_ceiling", "execution_classification", "allowed", "forbidden_claims", "formal_credit"], "properties": {"claim_ceiling": {"const": "manufactured_inverse_feedback/screen_only"}, "execution_classification": {"const": "not_executed_until_fresh_refreeze"}, "allowed": {"const": ["exact_software_fixture", "typed_failure", "deterministic_replay"]}, "forbidden_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "formal_credit": {"const": "none"}}}
  }
}

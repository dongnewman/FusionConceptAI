{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusionconceptai.invalid/m5-inverse-feedback-r2/canonical-bundle.schema.json",
  "title": "M5InverseFeedbackR2CanonicalBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_schema", "payload", "payload_sha256", "serialization_profile"],
  "properties": {
    "bundle_schema": {"const": "M5InverseFeedbackR2CanonicalBundleV1"},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "serialization_profile": {"const": "JCS-UTF8-LF-RATIONAL-SHA256-V1"},
    "payload": {"$ref": "#/$defs/payload"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "source", "parent_baseline", "mission", "scenario", "applicability"],
      "properties": {
        "candidate": {"$ref": "#/$defs/candidate"},
        "source": {"$ref": "#/$defs/source"},
        "parent_baseline": {"$ref": "#/$defs/parent"},
        "mission": {"$ref": "#/$defs/mission"},
        "scenario": {"$ref": "#/$defs/scenario"},
        "applicability": {"$ref": "#/$defs/applicability"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["body", "body_sha256"],
      "properties": {
        "body_sha256": {"$ref": "#/$defs/sha"},
        "body": {
          "type": "object", "additionalProperties": false,
          "required": ["candidate_ref", "g1", "g2", "g3", "parent_baseline_ref", "mission_ref", "scenario_id", "physical_subject"],
          "properties": {
            "candidate_ref": {"$ref": "#/$defs/ref"},
            "g1": {"$ref": "#/$defs/versioned_ref"},
            "g2": {"$ref": "#/$defs/versioned_ref"},
            "g3": {"$ref": "#/$defs/versioned_ref"},
            "parent_baseline_ref": {"$ref": "#/$defs/ref"},
            "mission_ref": {"$ref": "#/$defs/ref"},
            "scenario_id": {"$ref": "#/$defs/ref"},
            "physical_subject": {"const": "manufactured_screen_only_nonphysical"}
          }
        }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["body", "body_sha256"],
      "properties": {
        "body_sha256": {"$ref": "#/$defs/sha"},
        "body": {
          "type": "object", "additionalProperties": false,
          "required": ["source_ref", "source_schema", "content_sha256", "owner", "provenance_ref", "provenance_sha256", "applicability_domain"],
          "properties": {
            "source_ref": {"$ref": "#/$defs/ref"},
            "source_schema": {"$ref": "#/$defs/ref"},
            "content_sha256": {"$ref": "#/$defs/sha"},
            "owner": {"$ref": "#/$defs/ref"},
            "provenance_ref": {"$ref": "#/$defs/ref"},
            "provenance_sha256": {"$ref": "#/$defs/sha"},
            "applicability_domain": {"const": "manufactured_fixture_only"}
          }
        }
      }
    },
    "parent": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "content_sha256", "owner"],
      "properties": {"ref": {"$ref": "#/$defs/ref"}, "content_sha256": {"$ref": "#/$defs/sha"}, "owner": {"$ref": "#/$defs/ref"}}
    },
    "mission": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "body", "body_sha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "body_sha256": {"$ref": "#/$defs/sha"},
        "body": {"type": "object", "additionalProperties": false, "required": ["mission_ref", "objective", "claim_ceiling"], "properties": {"mission_ref": {"$ref": "#/$defs/ref"}, "objective": {"const": "manufactured_inverse_feedback_screen"}, "claim_ceiling": {"const": "manufactured_inverse_feedback/screen_only"}}}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "body", "body_sha256"],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/ref"},
        "body_sha256": {"$ref": "#/$defs/sha"},
        "body": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "kind", "units", "direction"], "properties": {"scenario_id": {"$ref": "#/$defs/ref"}, "kind": {"const": "manufactured_feedback_on_off"}, "units": {"const": "dimensionless_fixture"}, "direction": {"enum": ["forward_to_response", "response_to_parameter"]}}}
      }
    },
    "versioned_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "schema", "content_sha256", "body_sha256"],
      "properties": {"ref": {"$ref": "#/$defs/ref"}, "schema": {"$ref": "#/$defs/ref"}, "content_sha256": {"$ref": "#/$defs/sha"}, "body_sha256": {"$ref": "#/$defs/sha"}}
    },
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["execution_class", "real_reference", "hardware", "provider", "solver"],
      "properties": {"execution_class": {"const": "isolated_manufactured_fixture"}, "real_reference": {"const": "not_applicable"}, "hardware": {"const": "not_applicable"}, "provider": {"const": "forbidden"}, "solver": {"const": "forbidden"}}
    }
  }
}

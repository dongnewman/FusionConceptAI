{
  "schema": "EngineeringFeedbackSliceResultV2",
  "status_enum": ["valid_screen", "typed_failure", "terminal_deferred", "fail_closed", "not_executed"],
  "claim_ceiling": "manufactured_inverse_feedback/screen_only",
  "formal_credit": "none",
  "required": [
    "schema",
    "valid",
    "status",
    "binding_receipt",
    "forward",
    "inverse",
    "engineering_feedback",
    "failures",
    "evidence",
    "replay_receipt"
  ],
  "binding_receipt": {
    "type": "CandidateSourceBindingReceiptV2",
    "required": ["candidate_ref", "source_ref", "scenario_id", "input_sha256", "upstream_hashes", "owner_ledger", "provenance_ledger"],
    "rule": "receipt is a complete candidate/source/upstream join, not a program hash"
  },
  "forward": {
    "type": "ManufacturedForwardRecordV2",
    "required": ["matrix", "rhs", "response", "determinant", "eigenvalues", "margin_proxy", "residual", "units"],
    "derived_rule": "all fields are recomputed from canonical target/rhs/parameters"
  },
  "inverse": {
    "type": "ManufacturedInverseRecordV2",
    "required": ["recovered_parameters", "multi_start_ledger", "roundtrip_residual", "identifiability", "rank_condition"],
    "nonidentifiable_rule": "report identifiable combinations/intervals or typed failure; do not select an arbitrary winner"
  },
  "engineering_feedback": {
    "type": "FeedbackCausalDeltaRecordV2",
    "required": ["edge_identity", "active_response", "deleted_response", "delta", "response_changed", "units", "evidence_scope"],
    "frozen_negative": {"deleted_response": ["1/2", "0/1"], "delta": ["1/6", "1/3"], "response_changed": true},
    "boundary": "software causal negative control only; no hardware, thermal, structural or control qualification"
  },
  "failures": {
    "type": "TypedFailureRecordV2[]",
    "item_required": ["code", "path", "detail", "resolution", "claim_ceiling"],
    "ordering": "canonical path then code then detail"
  },
  "evidence": {
    "type": "EvidenceReceiptV2",
    "required": ["claim_ceiling", "execution_classification", "raw_refs", "process_refs", "input_sha256", "output_sha256", "artifact_sha256"],
    "forbidden_values": ["credible", "physical_pass", "engineering_pass", "provider_pass"]
  },
  "replay_receipt": {
    "type": "DeterministicReplayReceiptV2",
    "required": ["canonical_output_sha256", "semantic_equal", "byte_equal", "seed_order", "oracle_checker_order", "replay_count", "exit_codes"],
    "rule": "input or environment change requires a new freeze; exit 0 alone is insufficient"
  }
}

{
  "schema": "EngineeringFeedbackFailureTaxonomyV2",
  "claim_ceiling": "manufactured_inverse_feedback/screen_only",
  "rules": {
    "missing_authority": "unknown+terminal_deferred",
    "contradiction_or_foreign_identity": "fail_closed",
    "numerical_fixture_failure": "typed_failure",
    "runtime_exception_or_interruption": "preserve raw/PID/UTC/exit; never pass"
  },
  "codes": [
    {"code":"invalid_input","class":"contract","resolution":"fail_closed"},
    {"code":"invalid_upstream","class":"contract","resolution":"fail_closed"},
    {"code":"candidate_unbound","class":"authority","resolution":"unknown+terminal_deferred"},
    {"code":"source_unbound","class":"authority","resolution":"unknown+terminal_deferred"},
    {"code":"scenario_unbound","class":"authority","resolution":"unknown+terminal_deferred"},
    {"code":"foreign_hash","class":"provenance","resolution":"fail_closed"},
    {"code":"foreign_owner","class":"provenance","resolution":"fail_closed"},
    {"code":"foreign_provenance","class":"provenance","resolution":"fail_closed"},
    {"code":"schema_mismatch","class":"contract","resolution":"fail_closed"},
    {"code":"unit_or_direction_mismatch","class":"contract","resolution":"fail_closed"},
    {"code":"target_invalid","class":"fixture","resolution":"typed_failure"},
    {"code":"nonidentifiable_target","class":"fixture","resolution":"typed_failure"},
    {"code":"singular","class":"fixture","resolution":"typed_failure"},
    {"code":"non_spd","class":"fixture","resolution":"typed_failure"},
    {"code":"impossible_target","class":"fixture","resolution":"typed_failure"},
    {"code":"roundtrip","class":"fixture","resolution":"typed_failure"},
    {"code":"seed_mismatch","class":"determinism","resolution":"typed_failure"},
    {"code":"feedback_deletion_no_effect","class":"causal_negative","resolution":"typed_failure"},
    {"code":"numerical_nonfinite","class":"numerical","resolution":"typed_failure"},
    {"code":"numerical_fail","class":"numerical","resolution":"typed_failure"},
    {"code":"budget_exhausted","class":"execution","resolution":"typed_failure"},
    {"code":"provider_unavailable","class":"external_authority","resolution":"unknown+terminal_deferred"},
    {"code":"out_of_domain","class":"external_authority","resolution":"unknown+terminal_deferred"},
    {"code":"real_reference_missing","class":"B07B","resolution":"unknown+terminal_deferred"},
    {"code":"hardware_authority_missing","class":"B07A","resolution":"unknown+terminal_deferred"},
    {"code":"solver_not_authorized","class":"scope","resolution":"fail_closed"},
    {"code":"program_exception","class":"execution","resolution":"preserve_raw"},
    {"code":"human_interruption","class":"execution","resolution":"preserve_raw"},
    {"code":"unknown","class":"evidence","resolution":"unknown+terminal_deferred"}
  ]
}

{
  "schema": "UP3BudgetAndOracleTemplateV1",
  "status": "pending_review",
  "claim_ceiling": "contract_only",
  "freeze_before_first_run": true,
  "identity_placeholders": {
    "candidate": {"type": "CandidateIdentityV1", "state": "pending", "value": null},
    "scenario": {"type": "ScenarioIdentityV1", "state": "pending", "value": null},
    "input": {"type": "SolverInputIdentityV1", "state": "pending", "value": null},
    "provider": {"type": "ProviderManifestIdentityV1", "state": "pending", "value": null},
    "hash_bundle": {"type": "HashBundleV1", "state": "pending", "value": null}
  },
  "budget_dimensions": {
    "campaign": ["max_cells", "max_candidates_per_cell", "max_scenarios_per_candidate", "max_retries", "max_replays"],
    "numerical": ["max_iterations", "max_nonlinear_iterations", "max_linear_iterations", "residual_tolerance", "relative_update_tolerance", "conservation_tolerance", "mms_error_tolerance", "order_tolerance"],
    "time": ["parse_timeout", "compile_timeout", "provider_timeout", "solver_timeout", "oracle_timeout", "checker_timeout", "wall_timeout"],
    "resource": ["cpu_cores", "memory_bytes", "gpu_count", "gpu_memory_bytes", "disk_bytes", "queue_class", "heavy_lane"],
    "artifacts": ["max_stdout_bytes", "max_stderr_bytes", "max_artifact_bytes", "required_artifact_set", "retention_policy"],
    "determinism": ["random_seed", "thread_count", "floating_point_mode", "ordering_policy", "restart_policy"]
  },
  "budget_record_template": {
    "budget_id": {"type": "BudgetIdentityV1", "state": "pending", "value": null},
    "scope": "campaign|cell|scenario|oracle|replay",
    "candidate": {"type": "CandidateIdentityV1", "state": "pending", "value": null},
    "scenario": {"type": "ScenarioIdentityV1", "state": "pending", "value": null},
    "input": {"type": "SolverInputIdentityV1", "state": "pending", "value": null},
    "provider": {"type": "ProviderManifestIdentityV1", "state": "pending", "value": null},
    "hashes": {"type": "HashBundleV1", "state": "pending", "value": null},
    "values": {
      "max_iterations": null,
      "timeouts_seconds": {"parse": null, "compile": null, "provider": null, "solver": null, "oracle": null, "checker": null, "wall": null},
      "resource": {"cpu_cores": null, "memory_bytes": null, "gpu_count": null, "gpu_memory_bytes": null, "disk_bytes": null, "queue_class": null},
      "tolerances": {"residual": null, "relative_update": null, "conservation": null, "mms_error": null, "order": null},
      "retry_limit": null,
      "random_seed": null
    },
    "units": {"type": "UnitBundleV1", "state": "pending", "value": null},
    "status": "pending_freeze",
    "authority": "protocol_review_required"
  },
  "stop_conditions": [
    {"id": "STOP-parse", "condition": "typed parse/identity/closure rejection", "classification": "fail_closed", "provider_allowed": false, "solver_allowed": false},
    {"id": "STOP-gap", "condition": "no unique provider, missing authority, or out-of-domain axis", "classification": "terminal_deferred", "provider_allowed": false, "solver_allowed": false},
    {"id": "STOP-budget", "condition": "iteration, wall, memory, GPU or artifact budget exhausted", "classification": "deferred_or_numerical_fail", "retry": "new_receipt_only"},
    {"id": "STOP-nonfinite", "condition": "NaN, Inf, malformed output or checker input", "classification": "numerical_fail_or_program_exception"},
    {"id": "STOP-conservation", "condition": "per-node/per-region/per-interface ledger exceeds frozen tolerance", "classification": "numerical_fail; physical_fail only after applicable converged law"},
    {"id": "STOP-scenario", "condition": "any required universal scenario has no terminal receipt", "classification": "unknown_or_terminal_deferred"},
    {"id": "STOP-replay", "condition": "independent replay identity, artifact or terminal classification differs", "classification": "program_exception_or_numerical_fail"}
  ],
  "oracle_interfaces": {
    "parser": {
      "request_type": "CompositionInputV1",
      "response_type": "ParseReceiptV1",
      "required_fields": ["candidate", "scenario", "input", "provider", "genome_refs", "axis_values", "typed_ports", "closure_accounts"],
      "must_report": ["canonical_identity", "error_path", "error_code", "compile_calls", "provider_calls", "solver_calls"],
      "status": "pending_implementation"
    },
    "analytic_mms": {
      "request_type": "MmsRequestV1",
      "response_type": "MmsReceiptV1",
      "required_fields": ["exact_solution", "source", "boundary_initial", "units", "grid_time_sequence", "quadrature", "normalization", "declared_asymptotic_range"],
      "must_report": ["per_level_l2", "per_level_linf", "residual", "observed_order", "source_boundary_identity", "solver_exit"],
      "status": "pending_implementation"
    },
    "conservation": {
      "request_type": "ConservationRequestV1",
      "response_type": "ConservationReceiptV1",
      "required_fields": ["ledger_law", "owner_scope", "per_node_accounts", "per_region_accounts", "interface_flux_pairs", "units", "normalization"],
      "must_report": ["per_account_residual", "interface_defect", "duplicate_terms", "unowned_terms", "orientation", "closure_status"],
      "status": "pending_implementation"
    }
  },
  "resource_policy": {
    "heavy_execution_lane": "serialized_only",
    "provider_or_solver_start": "requires_frozen_manifest_and_current_lane_ownership",
    "resume": "new_recovery_receipt; completed evidence not counted twice",
    "cross_campaign_cache": "forbidden",
    "status": "pending_review"
  },
  "acceptance": {
    "thresholds_visible_before_results": true,
    "all_required_scenarios_terminal": false,
    "oracle_and_solver_identity_join": "pending",
    "independent_replay": "pending",
    "status": "pending"
  }
}

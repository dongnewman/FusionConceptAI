{
  "schema": "UP1.g2-production-profile-schema.v1",
  "profile_role": "strict_future_present_evaluator_schema",
  "unknown_fields": "reject_at_every_object",
  "duplicate_keys": "reject",
  "production_admission": "only structurally valid non-TEST_ONLY profiles may be admissible; TEST_ONLY is always non_evidence",
  "required_top_level": ["fixture_role", "status", "production_present_admission", "mapping"],
  "required_mapping": ["namespace", "version", "effective_interval", "issuer", "trust_root", "signature", "revocation", "anti_replay", "ambiguity", "conflict", "source_ref", "candidate_ref", "evidence_ref", "binding_edges"],
  "required_security_fields": [
    "namespace", "version", "effective_interval.not_before", "effective_interval.not_after", "effective_interval.trusted_time",
    "issuer.id", "issuer.chain", "signature.algorithm", "signature.signature_bytes", "signature.key_id", "signature.certificate_chain",
    "trust_root.fingerprint", "trust_root.policy_oid", "trust_root.eku", "trust_root.key_usage", "trust_root.name_constraints",
    "revocation.status", "revocation.source", "revocation.checked_at", "revocation.freshness_seconds",
    "anti_replay.enabled", "anti_replay.nonce", "anti_replay.sequence", "anti_replay.idempotency_key", "anti_replay.replay_status",
    "ambiguity.state", "ambiguity.competing_entries", "ambiguity.decision", "conflict.state", "conflict.conflicts", "conflict.resolution",
    "binding_edges.source_candidate_edge", "binding_edges.candidate_source_edge", "binding_edges.source_evidence_edge", "binding_edges.evidence_source_edge"
  ],
  "binding_policy": "source/candidate/evidence refs and SHA-256 edges must be bidirectionally equal",
  "synthetic_profile_policy": "explicit TEST_ONLY synthetic profile may be accepted only as non_evidence"
}

  "findings": [
    {
      "id": "F01",
      "area": "sibling_split_and_dag",
      "status": "pass",
      "detail": "G1 and G2 have distinct semantic owners; sibling dependencies are acyclic and do not modify T0/T1/T2."
    },
    {
      "id": "F02",
      "area": "current_blockers",
      "status": "real_but_under_specified",
      "detail": "Current V1 APIs lack child state, parent binding, typed provenance/absence, CAS guards, operation lineage and fail-atomic receipts; the audit must freeze exact schemas before dispatch."
    },
    {
      "id": "F03",
      "area": "parent_declaration_envelope",
      "status": "changes_requested",
      "detail": "Add exact typed candidate/parent/child bindings and recomputed parent/child identity hash rules; G1 has no external typed parent declaration ref and G2 contract_ref is not a parent binding."
    },
    {
      "id": "F04",
      "area": "provenance_and_absence",
      "status": "changes_requested",
      "detail": "Freeze four distinct slot types and a tagged absence hash domain including axis, candidate, parent, child and reason."
    },
    {
      "id": "F05",
      "area": "six_hash_layers_and_history",
      "status": "changes_requested",
      "detail": "Store/recompute child_contract_identity_hash, add domain tags, and define history as operation digests rather than recursive state objects."
    },
    {
      "id": "F06",
      "area": "operation_receipt_and_atomicity",
      "status": "changes_requested",
      "detail": "Freeze complete replace_source_payload and receipt fields, separate stale source/state errors, and require canonical bytes plus SHA unchanged on every failed call."
    },
    {
      "id": "F07",
      "area": "semantic_and_execution_boundary",
      "status": "pass_with_guard",
      "detail": "Retain G1 mechanism ownership and G2 geometry ownership; enforce mesh-plan declaration versus mesh execution and terminal_deferred not_executed semantics."
    },
    {
      "id": "F08",
      "area": "file_scope_and_evidence",
      "status": "pass_with_clarification",
      "detail": "Fixtures and static QA are necessary; any future dedicated launcher must be explicitly included in test scope or omitted in favor of direct test invocation."
    }
  ],
  "minimum_repairs": [
    "Freeze additive typed parent/declaration envelopes with candidate/parent/child identity and baseline hash bindings.",
    "Freeze four typed provenance slots and tagged typed absence records/hashes.",
    "Freeze six non-recursive domain-tagged hash recipes and digest-only operation history.",
    "Freeze closed operation/receipt/state fields, two CAS guards, error codes and byte-stable failure behavior.",
    "Retain sibling DAG and semantic boundaries; explicitly scope any focused-evidence launcher."

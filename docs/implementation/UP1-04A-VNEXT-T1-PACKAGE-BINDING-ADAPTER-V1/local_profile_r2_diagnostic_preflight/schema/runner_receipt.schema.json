{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FusionConceptAI/GenomeV5/VNextT1PackageBindingAdapterV1/local_profile_r2_diagnostic_preflight/runner_receipt.schema.json",
  "title": "VNext T1 forged no-legacy diagnostic R2 runner receipt",
  "type": "object",
  "required": [
    "schema", "status", "accepted", "claimCeiling", "command",
    "timeoutSeconds", "startCount", "autoRetry", "hashesComparable",
    "ownedFilesUnchanged", "postflightZeroJuliaDesc",
    "diagnosticOutput", "fullExceptionText"
  ],
  "properties": {
    "schema": {"type": "string", "const": "VNextT1PackageBindingAdapterV1R2DiagnosticRunMetadataV1"},
    "status": {"type": "string"},
    "accepted": {"type": "boolean", "const": false},
    "claimCeiling": {"type": "string", "const": "contract_only"},
    "command": {"type": "string", "const": "julia --startup-file=no --history-file=no --project=. test/GenomeV5/Integration/VNextT1PackageBindingAdapterV1/vnext_t1_projection_diagnostic_r2_preflight.jl"},
    "timeoutSeconds": {"type": "integer", "const": 120},
    "startCount": {"type": "integer", "minimum": 0, "maximum": 1},
    "autoRetry": {"type": "boolean", "const": false},
    "juliaNumThreads": {"type": "string", "const": "1"},
    "hashesComparable": {"type": "boolean"},
    "ownedFilesUnchanged": {"type": "boolean"},
    "postflightZeroJuliaDesc": {"type": "boolean"},
    "staticQaExpectedChecks": {"type": "integer", "const": 26},
    "independentOracleExpectedChecks": {"type": "integer", "const": 17},
    "diagnosticOutput": {"type": "string", "const": "status_errors_stage_exception_type_message_digest_only"},
    "fullExceptionText": {"type": "string", "const": "not_recorded_by_probe"},
    "astContract": {"type": "string", "const": "source-structure-only"}
  },
  "additionalProperties": true
}

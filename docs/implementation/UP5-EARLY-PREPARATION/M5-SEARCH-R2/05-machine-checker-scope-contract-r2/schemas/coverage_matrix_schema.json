{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:fusionconceptai:m5-search-r2:coverage-matrix-v2",
  "type":"object","additionalProperties":false,
  "required":["schema","contract_id","coverage","negative_vectors","self_hash_policy"],
  "properties":{
    "schema":{"const":"M5SearchR2MachineCheckerCoverageMatrixV2"},
    "contract_id":{"const":"M5-SEARCH-R2-05-MACHINE-CHECKER-SCOPE-CONTRACT-R2"},
    "coverage":{"type":"array","minItems":8,"items":{"type":"object","additionalProperties":false,"required":["relation","name","invariants","vector_ids"],"properties":{"relation":{"pattern":"^P[12]-0[1-5]$"},"name":{"type":"string"},"invariants":{"type":"array","minItems":1,"items":{"type":"string"}},"vector_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}}}},
    "negative_vectors":{"type":"array","minItems":40,"items":{"$ref":"#/$defs/vector"}},
    "self_hash_policy":{"type":"object","additionalProperties":false,"required":["manifest_self_hash","hash_manifest_self_hash","attempted_inclusion_expected_status","attempted_inclusion_expected_failure_code"],"properties":{"manifest_self_hash":{"const":"excluded_by_policy"},"hash_manifest_self_hash":{"const":"excluded_by_policy"},"attempted_inclusion_expected_status":{"const":"fail_closed"},"attempted_inclusion_expected_failure_code":{"const":"provenance_changed"}}}
  },
  "$defs":{"vector":{"type":"object","additionalProperties":false,"required":["id","relation","sub_relation","mutation","expected_status","expected_failure_code"],"properties":{"id":{"pattern":"^P[12]-0[1-5]-[0-9]{2}$"},"relation":{"pattern":"^P[12]-0[1-5]$"},"sub_relation":{"type":"string"},"mutation":{"type":"string"},"expected_status":{"type":"string"},"expected_failure_code":{"type":"string"}}}}
}

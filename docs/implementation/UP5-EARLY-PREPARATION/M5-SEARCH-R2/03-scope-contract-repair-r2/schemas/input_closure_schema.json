    "scenario_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "budget_config_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "descriptor_schema_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "emitter_config_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "upstream_provenance_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "closure_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"authority_status": {"const": "authoritative"}}},
      "then": {
        "properties": {
          "fixture": {"properties": {"authority_status": {"const": "authoritative"}}},
          "grammar": {"properties": {"authority_status": {"const": "authoritative"}}},
          "canonical_schema": {"properties": {"authority_status": {"const": "authoritative"}}},
          "source_bundle": {"properties": {"authority_status": {"const": "authoritative"}}},
          "mission_hash": {"type": "string"},
          "bounds_hash": {"type": "string"},
          "scenario_hash": {"type": "string"},
          "budget_config_hash": {"type": "string"},
          "descriptor_schema_hash": {"type": "string"},
          "emitter_config_hash": {"type": "string"}
        }
      }
    }
  ]
}

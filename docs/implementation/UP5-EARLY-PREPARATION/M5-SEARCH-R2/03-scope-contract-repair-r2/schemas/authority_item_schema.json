{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "M5SearchR2AuthorityItemV2",
  "title": "M5SearchR2AuthorityItemV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "kind", "authority_status", "content_path", "content_sha256", "canonical_bytes_sha256", "owner_id", "source_ref", "frozen_at", "metadata_sha256", "authority_receipt_hash"],
  "properties": {
    "schema": {"const": "M5SearchR2AuthorityItemV2"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^v[0-9]+$"},
    "kind": {"enum": ["fixture", "grammar", "canonical_schema", "source_bundle", "entrypoint", "oracle", "checker", "environment"]},
    "authority_status": {"enum": ["authoritative", "typed_absent", "stale", "foreign", "malformed"]},
    "content_path": {"type": ["string", "null"], "minLength": 1},
    "content_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "canonical_bytes_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "owner_id": {"type": ["string", "null"], "minLength": 1},
    "source_ref": {"type": ["string", "null"], "minLength": 1},
    "frozen_at": {"type": ["string", "null"], "format": "date-time"},
    "metadata_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "authority_receipt_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"authority_status": {"const": "authoritative"}}}, "then": {"required": ["content_path", "content_sha256", "canonical_bytes_sha256", "owner_id", "source_ref", "frozen_at", "metadata_sha256", "authority_receipt_hash"], "properties": {"content_path": {"type": "string", "minLength": 1}, "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "canonical_bytes_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "owner_id": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1}, "frozen_at": {"type": "string", "format": "date-time"}, "metadata_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "authority_receipt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    {"if": {"properties": {"authority_status": {"const": "typed_absent"}}}, "then": {"properties": {"content_path": {"type": "null"}, "content_sha256": {"type": "null"}, "canonical_bytes_sha256": {"type": "null"}, "owner_id": {"type": "null"}, "source_ref": {"type": "null"}, "frozen_at": {"type": "null"}, "metadata_sha256": {"type": "null"}, "authority_receipt_hash": {"type": "null"}}}}
  ]
}

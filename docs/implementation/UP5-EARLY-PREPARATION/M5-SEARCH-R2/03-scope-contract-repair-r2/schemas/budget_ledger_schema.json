  "properties": {
    "schema": {"const": "M5SearchR2BudgetLedgerV2"}, "ledger_id": {"type": "string", "minLength": 1}, "config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "scope": {"enum": ["per_seed", "global"]}, "seed": {"type": ["integer", "null"], "minimum": 0}, "descriptor_schema_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "descriptor_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "descriptor_cell": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 15}, {"type": "integer", "minimum": 0, "maximum": 15}], "items": false, "minItems": 2, "maxItems": 2},
    "caps": {"type": "object", "additionalProperties": false, "required": ["rewrite_applied", "eclass_created", "enode_created", "trace_rows", "qd_proposals", "qd_cells", "qd_members", "mcts_roots", "mcts_depth", "mcts_expansions", "mcts_proposals", "unique_prefixes", "screen_evaluations", "proposal_receipts", "global_trace_rows", "solver_executions", "provider_executions", "mesh_executions", "physical_executions"], "patternProperties": {".*": {"type": "integer", "minimum": 0}}},
    "events": {"type": "array", "items": {"$ref": "budget_event_schema.json"}},
    "final_counters": {"type": "object", "additionalProperties": false, "required": ["rewrite_applied", "eclass_created", "enode_created", "trace_rows", "qd_proposals", "qd_cells", "qd_members", "mcts_roots", "mcts_depth", "mcts_expansions", "mcts_proposals", "unique_prefixes", "screen_evaluations", "proposal_receipts", "global_trace_rows", "solver_executions", "provider_executions", "mesh_executions", "physical_executions"], "patternProperties": {".*": {"type": "integer", "minimum": 0}}},
    "event_list_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "counter_fold_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "stop": {"type": "object", "additionalProperties": false, "required": ["status", "reason", "failure_code", "resolution", "precedence_rank"], "properties": {"status": {"enum": ["complete", "budget_stop", "not_executed", "terminal_deferred", "fail_closed", "numerical_fail"]}, "reason": {"type": "string", "minLength": 1}, "failure_code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"}, "resolution": {"enum": ["none", "terminal_deferred", "no_publish", "fail_closed"]}, "precedence_rank": {"type": "integer", "minimum": 1, "maximum": 7}}}
  }

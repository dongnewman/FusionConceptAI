{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "M5SearchR2ContentReceiptV2",
  "title": "M5SearchR2ContentReceiptV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "content_receipt_id", "canonical_encoding", "authority_joins", "candidate_prefix", "emitter", "emitter_config_hash", "seed", "sequence", "ledger_id", "descriptor_schema_hash", "descriptor_hash", "descriptor_cell", "budget_snapshot", "trace_rows", "canonical_payload_sha256", "outcome", "failure_code", "canonical_content_sha256", "raw_content_refs"],
  "properties": {
    "schema": {"const": "M5SearchR2ContentReceiptV2"},
    "content_receipt_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canonical_encoding": {"const": "utf8-sorted-keys-explicit-null-finite-length-framed-v2"},
    "authority_joins": {"type": "object", "additionalProperties": false, "required": ["source_bundle_hash", "fixture_hash", "grammar_hash", "canonical_schema_hash", "mission_hash", "bounds_hash", "scenario_hash", "config_hash", "environment_hash"], "properties": {"source_bundle_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "fixture_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "grammar_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "canonical_schema_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "mission_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bounds_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "scenario_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "environment_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "candidate_prefix": {"type": "object", "additionalProperties": false, "required": ["candidate_prefix_hash", "parent_prefix_hash", "action_hash", "rule_hash", "canonical_payload_sha256"], "properties": {"candidate_prefix_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "parent_prefix_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "action_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "rule_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "canonical_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "emitter": {"enum": ["egraph", "QD", "MCTS", "replay"]}, "emitter_config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "seed": {"type": "integer", "minimum": 0}, "sequence": {"type": "integer", "minimum": 0}, "ledger_id": {"type": "string", "minLength": 1},
    "descriptor_schema_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "descriptor_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "descriptor_cell": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 15}, {"type": "integer", "minimum": 0, "maximum": 15}], "items": false, "minItems": 2, "maxItems": 2},
    "budget_snapshot": {"type": "object", "additionalProperties": false, "required": ["scope", "seed", "counters_sha256"], "properties": {"scope": {"enum": ["per_seed", "global"]}, "seed": {"type": ["integer", "null"], "minimum": 0}, "counters_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "trace_rows": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["sequence", "source_prefix_hash", "target_prefix_hash", "rule_hash", "condition_result"], "properties": {"sequence": {"type": "integer", "minimum": 0}, "source_prefix_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "target_prefix_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "rule_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "condition_result": {"enum": ["met", "unmet", "contradiction", "malformed"]}}}},
    "canonical_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "outcome": {"enum": ["admissible", "rejected", "budget_stop", "replay_observation", "not_executed"]}, "failure_code": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_.-]+$"}, "canonical_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "raw_content_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256", "bytes"], "properties": {"kind": {"enum": ["stdout", "stderr", "trace"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}}
  }
}

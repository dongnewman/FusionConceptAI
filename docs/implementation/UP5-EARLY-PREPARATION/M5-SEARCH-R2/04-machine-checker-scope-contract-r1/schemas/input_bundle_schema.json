{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fusionconceptai:m5-search-r2:machine-checker-input-v1",
  "title": "M5-SEARCH-R2 machine checker input bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "input_bundle_sha256", "provenance", "authority_registry", "input_closure", "m5c_gate", "budget_ledgers", "descriptor", "failure_observations", "prohibited_scan"],
  "properties": {
    "schema": {"const": "M5SearchR2MachineCheckerInputV1"},
    "contract_id": {"const": "M5-SEARCH-R2-04-MACHINE-CHECKER-SCOPE-CONTRACT-R1"},
    "input_bundle_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_ref"}},
    "authority_registry": {"type": "object", "additionalProperties": false, "required": ["closure_status", "items"], "properties": {"closure_status": {"enum": ["typed_absent", "authoritative"]}, "items": {"type": "array", "items": {"$ref": "#/$defs/authority_item"}}}},
    "input_closure": {"type": "object", "additionalProperties": false, "required": ["closure_status", "mission_hash", "bounds_hash", "scenario_hash", "config_hash", "descriptor_schema_hash"], "properties": {"closure_status": {"enum": ["typed_absent", "authoritative"]}, "mission_hash": {"type": ["string", "null"]}, "bounds_hash": {"type": ["string", "null"]}, "scenario_hash": {"type": ["string", "null"]}, "config_hash": {"type": ["string", "null"]}, "descriptor_schema_hash": {"type": ["string", "null"]}}},
    "m5c_gate": {"type": "object", "additionalProperties": false, "required": ["status", "authority_status", "gate_canonical_bytes_sha256", "gate_receipt_hash"], "properties": {"status": {"enum": ["typed_absent", "accepted", "rejected", "stale", "foreign", "malformed"]}, "authority_status": {"enum": ["typed_absent", "authoritative"]}, "gate_canonical_bytes_sha256": {"type": ["string", "null"]}, "gate_receipt_hash": {"type": ["string", "null"]}}},
    "budget_ledgers": {"type": "array", "items": {"$ref": "#/$defs/budget_ledger"}},
    "descriptor": {"type": "object", "additionalProperties": false, "required": ["schema", "descriptor_schema_hash", "descriptor_hash", "cell_key", "canonical_input_sha256", "tie_break"], "properties": {"schema": {"const": "M5SearchR2SyntheticDescriptorV2"}, "descriptor_schema_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "descriptor_hash": {"type": ["string", "null"]}, "cell_key": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 15}}, "canonical_input_sha256": {"type": ["string", "null"]}, "tie_break": {"const": ["cell_key", "quality_key", "canonical_prefix_hash", "seed", "sequence"]}}},
    "failure_observations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["observation", "stage", "derived_class", "derived_rank"], "properties": {"observation": {"type": "string"}, "stage": {"type": "string"}, "derived_class": {"type": "string"}, "derived_rank": {"type": "integer", "minimum": 1, "maximum": 7}}}},
    "prohibited_scan": {"type": "object", "additionalProperties": false, "required": ["registry_version", "tokens_sha256", "input_refs", "input_bundle_sha256", "algorithm_sha256", "scan_receipt_sha256", "scan_status"], "properties": {"registry_version": {"const": "v2"}, "tokens_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "input_refs": {"type": "array"}, "input_bundle_sha256": {"type": ["string", "null"]}, "algorithm_sha256": {"type": ["string", "null"]}, "scan_receipt_sha256": {"type": ["string", "null"]}, "scan_status": {"enum": ["not_executed", "pass", "fail", "incomplete"]}}}
  },
  "$defs": {
    "file_ref": {"type": "object", "additionalProperties": false, "required": ["relative_path", "bytes", "sha256"], "properties": {"relative_path": {"type": "string", "pattern": "^[^\\\\]+$"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "authority_item": {"type": "object", "additionalProperties": false, "required": ["id", "version", "authority_status", "content_path", "content_sha256", "canonical_bytes_sha256", "owner_id", "source_ref", "frozen_at", "metadata_sha256", "authority_receipt_hash"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "authority_status": {"enum": ["typed_absent", "authoritative"]}, "content_path": {"type": ["string", "null"]}, "content_sha256": {"type": ["string", "null"]}, "canonical_bytes_sha256": {"type": ["string", "null"]}, "owner_id": {"type": ["string", "null"]}, "source_ref": {"type": ["string", "null"]}, "frozen_at": {"type": ["string", "null"]}, "metadata_sha256": {"type": ["string", "null"]}, "authority_receipt_hash": {"type": ["string", "null"]}}},
    "budget_ledger": {"type": "object", "additionalProperties": false, "required": ["ledger_id", "config_sha256", "seed", "scope", "stage", "events", "final_counters", "event_list_sha256", "counter_fold_sha256"], "properties": {"ledger_id": {"type": "string"}, "config_sha256": {"type": "string"}, "seed": {"type": "integer"}, "scope": {"type": "string"}, "stage": {"type": "string"}, "events": {"type": "array"}, "final_counters": {"type": "object"}, "event_list_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "counter_fold_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}

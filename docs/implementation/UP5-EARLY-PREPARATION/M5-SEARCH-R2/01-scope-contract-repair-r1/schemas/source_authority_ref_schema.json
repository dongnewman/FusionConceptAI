{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M5SearchR2SourceAuthorityRefV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority_id", "version", "authority_status", "content_path", "content_sha256", "receipt_hash", "owner"],
  "properties": {
    "schema": {"const": "M5SearchR2SourceAuthorityRefV1"},
    "authority_id": {"type": "string"},
    "version": {"type": "string", "pattern": "^v[0-9]+$"},
    "authority_status": {"enum": ["authoritative", "typed_absent", "stale", "foreign", "malformed"]},
    "content_path": {"type": ["string", "null"]},
    "content_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "receipt_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "owner": {"type": ["string", "null"]}
  }
}

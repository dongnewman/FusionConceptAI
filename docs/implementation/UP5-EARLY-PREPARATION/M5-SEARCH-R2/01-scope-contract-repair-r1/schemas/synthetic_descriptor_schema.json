{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M5SearchR2SyntheticDescriptorV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "descriptor_id", "descriptor_hash", "source", "dimensions", "normalization", "derivation", "evidence_boundary"],
  "properties": {
    "schema": {"const": "M5SearchR2SyntheticDescriptorV1"}, "descriptor_id": {"const": "synthetic_descriptor_v1"}, "descriptor_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {"const": "canonical_typed_prefix_bytes_and_sealed_ledger_counts"},
    "dimensions": {"const": [{"name": "prefix_byte_mod_16", "unit": "index", "min": 0, "max": 15, "bins": 16}, {"name": "typed_node_count_mod_16", "unit": "index", "min": 0, "max": 15, "bins": 16}]},
    "normalization": {"const": "modulo_after_nonnegative_integer_projection"},
    "derivation": {"const": "deterministic_no_physics_no_provider_no_measurement"},
    "evidence_boundary": {"const": "occupancy_bookkeeping_only_not_behavior_capability_or_physical_evidence"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M5SearchR2InterfaceItemV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "kind", "authority_status", "path", "command", "interface_sha256", "lock_sha256"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "string", "pattern": "^v[0-9]+$"},
    "kind": {"enum": ["entrypoint", "oracle", "checker", "environment"]},
    "authority_status": {"enum": ["authoritative", "typed_absent", "stale", "foreign", "malformed"]},
    "path": {"type": ["string", "null"]},
    "command": {"type": ["array", "null"], "items": {"type": "string"}},
    "interface_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "lock_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "M5CFreezeReceiptV2",
  "type": "object",
  "required": ["schema", "run_id", "mode", "capture_command", "command_exit", "cwd", "powershell_pid", "utc_start", "utc_end", "head", "branch", "pre_process_count", "post_process_count", "current_inputs", "historical_inputs", "raw_row_mapping_ref", "receipt_sha256"],
  "properties": {
    "schema": {"const": "M5CFreezeReceiptV2"}, "run_id": {"type": "string"}, "mode": {"const": "read_only_static_fresh_freeze"}, "capture_command": {"type": "string"}, "command_exit": {"const": 0}, "cwd": {"type": "string"}, "host": {"type": "string"}, "powershell_pid": {"type": "integer", "minimum": 1}, "utc_start": {"type": "string", "format": "date-time"}, "utc_end": {"type": "string", "format": "date-time"}, "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "branch": {"type": "string"}, "pre_process_count": {"type": "object", "required": ["julia"], "properties": {"julia": {"const": 0}}}, "post_process_count": {"type": "object", "required": ["julia"], "properties": {"julia": {"const": 0}}}, "current_inputs": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/input"}}, "historical_inputs": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/historical"}}, "raw_row_mapping_ref": {"type": "string"}, "receipt_sha256": {"const": "excluded_until_manifest_seal"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "input": {"type": "object", "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/hash"}}}, "historical": {"type": "object", "required": ["path", "bytes", "sha256", "historical_only"], "properties": {"path": {"type": "string"}, "bytes": {"type": ["integer", "null"], "minimum": 0}, "sha256": {"$ref": "#/$defs/hash"}, "historical_only": {"const": true}}}}
}

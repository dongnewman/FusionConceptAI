  "properties":{"schema":{"const":"M5CFullBindingReceiptV3"},"receipt_id":{"type":"string"},"candidate_id":{"type":"string"},"layers":{"type":"array","minItems":9,"maxItems":9,"uniqueItems":true,"prefixItems":[{"$ref":"#/$defs/a"},{"$ref":"#/$defs/b"},{"$ref":"#/$defs/o"},{"$ref":"#/$defs/c"},{"$ref":"#/$defs/e"},{"$ref":"#/$defs/r"},{"$ref":"#/$defs/d"},{"$ref":"#/$defs/g"},{"$ref":"#/$defs/x"}],"items":{"$ref":"#/$defs/layer"}},"artifact_object_relation":{"enum":["same_object","mismatch","missing"]},"artifact_bytes":{"type":"string"},"artifact_sha256":{"$ref":"#/$defs/hash"},"graph_artifact_hash":{"$ref":"#/$defs/hash"},"canonical_hash_relation":{"enum":["equal","mismatch","missing"]},"aggregate":{"enum":["binding_ok","fail_closed"]},"producer_owner":{"const":"m5c_adapter"}},

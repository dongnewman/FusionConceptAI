{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"M5CBudgetReceiptV3","type":"object","additionalProperties":false,
  "required":["schema","requested_budget","sealed_budget","effective_budget","budget_relation","budget_applied","budget_reason","sealed_budget_hash","result_status","priority_rank","input_overload","sealed_product"],
  "properties":{"schema":{"const":"M5CBudgetReceiptV3"},"requested_budget":{"type":["integer","null"],"minimum":0},"sealed_budget":{"type":["integer","null"],"minimum":0},"effective_budget":{"type":"integer","minimum":0},"budget_relation":{"enum":["omitted","equal","sealed_budget_mismatch","over_limit","input_overload","invalid"]},"budget_applied":{"enum":["omitted_identity_preserve","equal_identity_preserve","reject_sealed_mismatch","defer_over_limit","rebuild_input_overload","reject_invalid"]},"budget_reason":{"enum":["budget_omitted","budget_equal","sealed_budget_mismatch","over_limit","input_overload","invalid_budget"]},"sealed_budget_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"result_status":{"enum":["no_op","budget_mismatch","rebuilt","terminal_deferred","fail_closed"]},"priority_rank":{"type":"integer","minimum":1,"maximum":6},"input_overload":{"type":"boolean"},"sealed_product":{"type":"boolean"}},
  "allOf":[
    {"if":{"properties":{"budget_relation":{"const":"omitted"}}},"then":{"properties":{"requested_budget":{"type":"null"},"budget_applied":{"const":"omitted_identity_preserve"},"budget_reason":{"const":"budget_omitted"},"result_status":{"const":"no_op"},"priority_rank":{"const":6},"input_overload":{"const":false}}}},
    {"if":{"properties":{"budget_relation":{"const":"equal"}}},"then":{"required":["requested_budget","sealed_budget"],"properties":{"budget_applied":{"const":"equal_identity_preserve"},"budget_reason":{"const":"budget_equal"},"result_status":{"const":"no_op"},"priority_rank":{"const":5},"sealed_product":{"const":true},"input_overload":{"const":false}}}},
    {"if":{"properties":{"budget_relation":{"const":"sealed_budget_mismatch"}}},"then":{"required":["requested_budget","sealed_budget"],"properties":{"budget_applied":{"const":"reject_sealed_mismatch"},"budget_reason":{"const":"sealed_budget_mismatch"},"result_status":{"const":"budget_mismatch"},"priority_rank":{"const":2},"sealed_product":{"const":true}}}},
    {"if":{"properties":{"budget_relation":{"const":"over_limit"}}},"then":{"properties":{"budget_applied":{"const":"defer_over_limit"},"budget_reason":{"const":"over_limit"},"result_status":{"const":"terminal_deferred"},"priority_rank":{"const":3},"sealed_product":{"const":false}}}},
    {"if":{"properties":{"budget_relation":{"const":"input_overload"}}},"then":{"properties":{"budget_applied":{"const":"rebuild_input_overload"},"budget_reason":{"const":"input_overload"},"result_status":{"const":"rebuilt"},"priority_rank":{"const":4},"input_overload":{"const":true},"sealed_product":{"const":false}}}},
    {"if":{"properties":{"budget_relation":{"const":"invalid"}}},"then":{"properties":{"budget_applied":{"const":"reject_invalid"},"budget_reason":{"const":"invalid_budget"},"result_status":{"const":"fail_closed"},"priority_rank":{"const":1}}}}
  ]
}

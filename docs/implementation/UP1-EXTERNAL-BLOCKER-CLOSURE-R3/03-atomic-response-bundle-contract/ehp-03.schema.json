{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:up1:external-handoff:ehp-03:v1",
  "title":"EHP-03 source, axis and G2 graph response payload v1",
  "type":"object","additionalProperties":false,
  "required":["schema","source_identity","axis_materials","evidence_graph","g2_mapping","authority_receipt"],
  "properties":{
    "schema":{"const":"UP1.external-handoff.ehp-03-response.v1"},
    "source_identity":{"type":"object","additionalProperties":false,"required":["candidate_id","revision","head","tree","dirty_patch","untracked","submodules","source_bytes_sha256","inventory_sha256"],"properties":{"candidate_id":{"type":"string","minLength":1},"revision":{"type":"string","minLength":1},"head":{"type":"string","minLength":1},"tree":{"$ref":"#/$defs/sha256"},"dirty_patch":{"$ref":"#/$defs/closure"},"untracked":{"$ref":"#/$defs/closure"},"submodules":{"$ref":"#/$defs/closure"},"source_bytes_sha256":{"$ref":"#/$defs/sha256"},"inventory_sha256":{"$ref":"#/$defs/sha256"}}},
    "axis_materials":{"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"$ref":"#/$defs/axis_material"}},
    "evidence_graph":{"type":"object","additionalProperties":false,"required":["forward_edges","reverse_edges","graph_sha256"],"properties":{"forward_edges":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/edge"}},"reverse_edges":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/edge"}},"graph_sha256":{"$ref":"#/$defs/sha256"}}},
    "g2_mapping":{"type":"object","additionalProperties":false,"required":["namespace","version","effective_interval","candidate_id","mapping_rows","reverse_rows","mapping_sha256","issuer_ref","ambiguity_decision"],"properties":{"namespace":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"effective_interval":{"$ref":"#/$defs/interval"},"candidate_id":{"type":"string","minLength":1},"mapping_rows":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/mapping_row"}},"reverse_rows":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/mapping_row"}},"mapping_sha256":{"$ref":"#/$defs/sha256"},"issuer_ref":{"$ref":"#/$defs/ref"},"ambiguity_decision":{"enum":["none","rejected"]}}},
    "authority_receipt":{"type":"object","additionalProperties":false,"required":["receipt_id","candidate_id","source_identity_sha256","graph_sha256","trusted_time_ref","revocation_ref","signature_ref"],"properties":{"receipt_id":{"type":"string","minLength":1},"candidate_id":{"type":"string","minLength":1},"source_identity_sha256":{"$ref":"#/$defs/sha256"},"graph_sha256":{"$ref":"#/$defs/sha256"},"trusted_time_ref":{"$ref":"#/$defs/ref"},"revocation_ref":{"$ref":"#/$defs/ref"},"signature_ref":{"$ref":"#/$defs/ref"}}}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"ref":{"type":"object","additionalProperties":false,"required":["ref","sha256"],"properties":{"ref":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"}}},"interval":{"type":"object","additionalProperties":false,"required":["not_before","not_after"],"properties":{"not_before":{"type":"string","format":"date-time"},"not_after":{"type":"string","format":"date-time"}}},"closure":{"type":"object","additionalProperties":false,"required":["present","sha256","entries"],"properties":{"present":{"const":true},"sha256":{"$ref":"#/$defs/sha256"},"entries":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}},"axis_material":{"type":"object","additionalProperties":false,"required":["axis_id","material_ref","material_sha256","version","issuer_ref","issued_at","signature_ref"],"properties":{"axis_id":{"type":"string","minLength":1},"material_ref":{"$ref":"#/$defs/ref"},"material_sha256":{"$ref":"#/$defs/sha256"},"version":{"type":"string","minLength":1},"issuer_ref":{"$ref":"#/$defs/ref"},"issued_at":{"type":"string","format":"date-time"},"signature_ref":{"$ref":"#/$defs/ref"}}},"edge":{"type":"object","additionalProperties":false,"required":["edge_id","from_kind","from_id","to_kind","to_id","candidate_id","source_identity_sha256","namespace","version","edge_sha256","issuer_ref","issued_at","signature_ref"],"properties":{"edge_id":{"type":"string","minLength":1},"from_kind":{"enum":["source","candidate","axis","evidence","g2"]},"from_id":{"type":"string","minLength":1},"to_kind":{"enum":["source","candidate","axis","evidence","g2"]},"to_id":{"type":"string","minLength":1},"candidate_id":{"type":"string","minLength":1},"source_identity_sha256":{"$ref":"#/$defs/sha256"},"namespace":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"edge_sha256":{"$ref":"#/$defs/sha256"},"issuer_ref":{"$ref":"#/$defs/ref"},"issued_at":{"type":"string","format":"date-time"},"signature_ref":{"$ref":"#/$defs/ref"}}},"mapping_row":{"type":"object","additionalProperties":false,"required":["row_id","from_id","to_id","row_sha256","issuer_ref","issued_at"],"properties":{"row_id":{"type":"string","minLength":1},"from_id":{"type":"string","minLength":1},"to_id":{"type":"string","minLength":1},"row_sha256":{"$ref":"#/$defs/sha256"},"issuer_ref":{"$ref":"#/$defs/ref"},"issued_at":{"type":"string","format":"date-time"}}}
  }
}

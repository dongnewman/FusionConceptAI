    "set_receipt": {"$ref":"#/$defs/set_receipt"},
    "independent_review": {"$ref":"#/$defs/independent_review"}
  },
  "$defs": {
    "sha256": {"type":"string", "pattern":"^[0-9a-f]{64}$"},
    "nonempty": {"type":"string", "minLength":1},
    "uuid": {"type":"string", "format":"uuid"},
    "digest_ref": {"type":"object", "additionalProperties":false, "required":["ref","sha256"], "properties":{"ref":{"$ref":"#/$defs/nonempty"},"sha256":{"$ref":"#/$defs/sha256"}}},
    "trusted_time": {"type":"object", "additionalProperties":false, "required":["token_ref","token_sha256","issuer","gen_time","nonce","verification_ref"], "properties":{"token_ref":{"$ref":"#/$defs/nonempty"},"token_sha256":{"$ref":"#/$defs/sha256"},"issuer":{"$ref":"#/$defs/nonempty"},"gen_time":{"type":"string","format":"date-time"},"nonce":{"$ref":"#/$defs/nonempty"},"verification_ref":{"$ref":"#/$defs/digest_ref"}}},
    "replay": {"type":"object", "additionalProperties":false, "required":["nonce","sequence","idempotency_key","ledger_ref","ledger_receipt_sha256"], "properties":{"nonce":{"type":"string","minLength":16},"sequence":{"type":"integer","minimum":0},"idempotency_key":{"type":"string","minLength":16},"ledger_ref":{"$ref":"#/$defs/nonempty"},"ledger_receipt_sha256":{"$ref":"#/$defs/sha256"}}},
    "axis_ref": {"type":"object", "additionalProperties":false, "required":["axis_id","version","sha256","issuer_ref"], "properties":{"axis_id":{"$ref":"#/$defs/nonempty"},"version":{"$ref":"#/$defs/nonempty"},"sha256":{"$ref":"#/$defs/sha256"},"issuer_ref":{"$ref":"#/$defs/digest_ref"}}},
    "g_ref": {"type":"object", "additionalProperties":false, "required":["ref","version","sha256"], "properties":{"ref":{"$ref":"#/$defs/nonempty"},"version":{"$ref":"#/$defs/nonempty"},"sha256":{"$ref":"#/$defs/sha256"}}},
    "shared_binding": {"type":"object", "additionalProperties":false, "required":["candidate_id","candidate_identity_sha256","source_identity_ref","source_identity_sha256","g1_ref","g2_ref","g3_ref","four_axis_refs","expected_context_sha256","trust_anchor_sha256","verifier_profile_sha256","request_time","expiry_time","replay"], "properties":{
      "candidate_id":{"$ref":"#/$defs/nonempty"},"candidate_identity_sha256":{"$ref":"#/$defs/sha256"},"source_identity_ref":{"$ref":"#/$defs/digest_ref"},"source_identity_sha256":{"$ref":"#/$defs/sha256"},"g1_ref":{"$ref":"#/$defs/g_ref"},"g2_ref":{"$ref":"#/$defs/g_ref"},"g3_ref":{"$ref":"#/$defs/g_ref"},"four_axis_refs":{"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"$ref":"#/$defs/axis_ref"}},"expected_context_sha256":{"$ref":"#/$defs/sha256"},"trust_anchor_sha256":{"$ref":"#/$defs/sha256"},"verifier_profile_sha256":{"$ref":"#/$defs/sha256"},"request_time":{"$ref":"#/$defs/trusted_time"},"expiry_time":{"$ref":"#/$defs/trusted_time"},"replay":{"$ref":"#/$defs/replay"}
    }},
    "owner": {"type":"object", "additionalProperties":false, "required":["owner_id","role","identity_sha256","certificate_ref"], "properties":{"owner_id":{"$ref":"#/$defs/nonempty"},"role":{"enum":["ehp01_witness","ehp02_pki_verifier","ehp03_source_authority","ehp04_environment_provider"]},"identity_sha256":{"$ref":"#/$defs/sha256"},"certificate_ref":{"$ref":"#/$defs/digest_ref"}}},
    "signature": {"type":"object", "additionalProperties":false, "required":["key_id","algorithm","profile_id","signature_b64","signature_sha256","owner_preimage_sha256"], "properties":{"key_id":{"$ref":"#/$defs/nonempty"},"algorithm":{"enum":["Ed25519","ECDSA-SHA256"]},"profile_id":{"$ref":"#/$defs/nonempty"},"signature_b64":{"$ref":"#/$defs/nonempty"},"signature_sha256":{"$ref":"#/$defs/sha256"},"owner_preimage_sha256":{"$ref":"#/$defs/sha256"}}},
    "packet_base": {"type":"object", "additionalProperties":false, "required":["packet_id","packet_version","owner","shared_binding","payload","payload_sha256","signature"], "properties":{"packet_id":{"enum":["EHP-01","EHP-02","EHP-03","EHP-04"]},"packet_version":{"const":"v1"},"owner":{"$ref":"#/$defs/owner"},"shared_binding":{"$ref":"#/$defs/shared_binding"},"payload":{},"payload_sha256":{"$ref":"#/$defs/sha256"},"signature":{"$ref":"#/$defs/owner_signature"}}},
    "packet_digest_01": {"type":"object","additionalProperties":false,"required":["packet_id","payload_sha256","owner_signature_sha256"],"properties":{"packet_id":{"const":"EHP-01"},"payload_sha256":{"$ref":"#/$defs/sha256"},"owner_signature_sha256":{"$ref":"#/$defs/sha256"}}},
    "packet_digest_02": {"type":"object","additionalProperties":false,"required":["packet_id","payload_sha256","owner_signature_sha256"],"properties":{"packet_id":{"const":"EHP-02"},"payload_sha256":{"$ref":"#/$defs/sha256"},"owner_signature_sha256":{"$ref":"#/$defs/sha256"}}},
    "packet_digest_03": {"type":"object","additionalProperties":false,"required":["packet_id","payload_sha256","owner_signature_sha256"],"properties":{"packet_id":{"const":"EHP-03"},"payload_sha256":{"$ref":"#/$defs/sha256"},"owner_signature_sha256":{"$ref":"#/$defs/sha256"}}},
    "packet_digest_04": {"type":"object","additionalProperties":false,"required":["packet_id","payload_sha256","owner_signature_sha256"],"properties":{"packet_id":{"const":"EHP-04"},"payload_sha256":{"$ref":"#/$defs/sha256"},"owner_signature_sha256":{"$ref":"#/$defs/sha256"}}},
    "channel": {"type":"object","additionalProperties":false,"required":["owner_id","endpoint","transport","protocol_version","pin_sha256","authentication","retention_seconds","ack_sla_seconds","allowed_packet_order"],"properties":{"owner_id":{"$ref":"#/$defs/nonempty"},"endpoint":{"$ref":"#/$defs/nonempty"},"transport":{"enum":["HTTPS","mTLS-HTTPS"]},"protocol_version":{"$ref":"#/$defs/nonempty"},"pin_sha256":{"$ref":"#/$defs/sha256"},"authentication":{"$ref":"#/$defs/nonempty"},"retention_seconds":{"type":"integer","minimum":1},"ack_sla_seconds":{"type":"integer","minimum":1},"allowed_packet_order":{"type":"array","minItems":4,"maxItems":4,"prefixItems":[{"const":"EHP-01"},{"const":"EHP-02"},{"const":"EHP-03"},{"const":"EHP-04"}],"items":false}}},
    "set_receipt": {"type":"object","additionalProperties":false,"required":["receipt_id","channel","bundle_id","request_id","packet_digests","shared_binding","durable_quarantine_sha256","received_time","decision","set_signature"],"properties":{"receipt_id":{"$ref":"#/$defs/nonempty"},"channel":{"$ref":"#/$defs/channel"},"bundle_id":{"$ref":"#/$defs/uuid"},"request_id":{"$ref":"#/$defs/uuid"},"packet_digests":{"type":"array","minItems":4,"maxItems":4,"prefixItems":[{"$ref":"#/$defs/packet_digest_01"},{"$ref":"#/$defs/packet_digest_02"},{"$ref":"#/$defs/packet_digest_03"},{"$ref":"#/$defs/packet_digest_04"}],"items":false},"shared_binding":{"$ref":"#/$defs/shared_binding"},"durable_quarantine_sha256":{"$ref":"#/$defs/sha256"},"received_time":{"$ref":"#/$defs/trusted_time"},"decision":{"enum":["accepted_all","rejected_all"]},"set_signature":{"$ref":"#/$defs/set_signature"}}},
    "independent_review": {"type":"object","additionalProperties":false,"required":["review_id","reviewer_id","reviewer_identity_sha256","separation_statement_sha256","verifier_ref","recomputed_packet_digests","recomputed_bundle_sha256","set_receipt_sha256","trust_outcome","time_outcome","revocation_outcome","replay_outcome","derived_decision","raw_receipt_refs","review_signature"],"properties":{"review_id":{"$ref":"#/$defs/nonempty"},"reviewer_id":{"$ref":"#/$defs/nonempty"},"reviewer_identity_sha256":{"$ref":"#/$defs/sha256"},"separation_statement_sha256":{"$ref":"#/$defs/sha256"},"verifier_ref":{"$ref":"#/$defs/digest_ref"},"recomputed_packet_digests":{"type":"array","minItems":4,"maxItems":4,"prefixItems":[{"$ref":"#/$defs/packet_digest_01"},{"$ref":"#/$defs/packet_digest_02"},{"$ref":"#/$defs/packet_digest_03"},{"$ref":"#/$defs/packet_digest_04"}],"items":false},"recomputed_bundle_sha256":{"$ref":"#/$defs/sha256"},"set_receipt_sha256":{"$ref":"#/$defs/sha256"},"trust_outcome":{"enum":["pass","fail"]},"time_outcome":{"enum":["pass","fail"]},"revocation_outcome":{"enum":["pass","fail"]},"replay_outcome":{"enum":["pass","fail"]},"derived_decision":{"enum":["accepted_all","rejected_all","terminal_deferred"]},"raw_receipt_refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/digest_ref"}},"review_signature":{"$ref":"#/$defs/review_signature"}}},
    "owner_signature": {"type":"object","additionalProperties":false,"required":["key_id","algorithm","profile_id","signature_b64","signature_sha256","owner_preimage_sha256"],"properties":{"key_id":{"$ref":"#/$defs/nonempty"},"algorithm":{"enum":["Ed25519","ECDSA-SHA256"]},"profile_id":{"$ref":"#/$defs/nonempty"},"signature_b64":{"$ref":"#/$defs/nonempty"},"signature_sha256":{"$ref":"#/$defs/sha256"},"owner_preimage_sha256":{"$ref":"#/$defs/sha256"}}},
    "set_signature": {"type":"object","additionalProperties":false,"required":["key_id","algorithm","profile_id","signature_b64","signature_sha256","set_preimage_sha256"],"properties":{"key_id":{"$ref":"#/$defs/nonempty"},"algorithm":{"enum":["Ed25519","ECDSA-SHA256"]},"profile_id":{"$ref":"#/$defs/nonempty"},"signature_b64":{"$ref":"#/$defs/nonempty"},"signature_sha256":{"$ref":"#/$defs/sha256"},"set_preimage_sha256":{"$ref":"#/$defs/sha256"}}},
    "review_signature": {"type":"object","additionalProperties":false,"required":["key_id","algorithm","profile_id","signature_b64","signature_sha256","review_preimage_sha256"],"properties":{"key_id":{"$ref":"#/$defs/nonempty"},"algorithm":{"enum":["Ed25519","ECDSA-SHA256"]},"profile_id":{"$ref":"#/$defs/nonempty"},"signature_b64":{"$ref":"#/$defs/nonempty"},"signature_sha256":{"$ref":"#/$defs/sha256"},"review_preimage_sha256":{"$ref":"#/$defs/sha256"}}}
  }
}

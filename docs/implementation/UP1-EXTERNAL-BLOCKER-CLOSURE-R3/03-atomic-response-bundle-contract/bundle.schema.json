{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:up1:external-handoff:atomic-response-bundle:v1",
  "title": "UP1 external handoff atomic response bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "request_id", "bundle_version", "packet_order", "shared_binding", "packets", "packet_digests", "bundle_canonical_sha256", "set_receipt", "independent_review"],
  "properties": {
    "schema": {"const": "UP1.external-handoff.atomic-response-bundle.v1"},
    "bundle_id": {"type": "string", "format": "uuid"},
    "request_id": {"type": "string", "format": "uuid"},
    "recovery_of_bundle_id": {"type": "string", "format": "uuid"},
    "bundle_version": {"const": "v1"},
    "packet_order": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [{"const":"EHP-01"},{"const":"EHP-02"},{"const":"EHP-03"},{"const":"EHP-04"}], "items": false},
    "shared_binding": {"$ref": "#/$defs/shared_binding"},
    "packets": {"type":"array", "minItems":4, "maxItems":4, "prefixItems":[
      {"allOf":[{"$ref":"#/$defs/packet_base"},{"properties":{"packet_id":{"const":"EHP-01"},"payload":{"$ref":"ehp-01.schema.json"}}}]},
      {"allOf":[{"$ref":"#/$defs/packet_base"},{"properties":{"packet_id":{"const":"EHP-02"},"payload":{"$ref":"ehp-02.schema.json"}}}]},
      {"allOf":[{"$ref":"#/$defs/packet_base"},{"properties":{"packet_id":{"const":"EHP-03"},"payload":{"$ref":"ehp-03.schema.json"}}}]},
      {"allOf":[{"$ref":"#/$defs/packet_base"},{"properties":{"packet_id":{"const":"EHP-04"},"payload":{"$ref":"ehp-04.schema.json"}}}]}
    ], "items":false},
    "packet_digests": {"type":"array", "minItems":4, "maxItems":4, "prefixItems":[
      {"$ref":"#/$defs/packet_digest_01"},{"$ref":"#/$defs/packet_digest_02"},{"$ref":"#/$defs/packet_digest_03"},{"$ref":"#/$defs/packet_digest_04"}

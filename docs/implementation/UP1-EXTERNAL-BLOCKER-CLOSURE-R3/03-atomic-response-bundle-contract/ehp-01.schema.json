{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:up1:external-handoff:ehp-01:v1",
  "title":"EHP-01 witness authority response payload v1",
  "type":"object","additionalProperties":false,
  "required":["schema","witness_identity","independence","attestation_scope","leaf_attestation","ack_binding"],
  "properties":{
    "schema":{"const":"UP1.external-handoff.ehp-01-response.v1"},
    "witness_identity":{"type":"object","additionalProperties":false,"required":["stable_id","qualification_sha256","validity","identity_evidence_sha256","issuer_ref","candidate_scope"],"properties":{"stable_id":{"type":"string","minLength":1},"qualification_sha256":{"$ref":"#/$defs/sha256"},"validity":{"$ref":"#/$defs/interval"},"identity_evidence_sha256":{"$ref":"#/$defs/sha256"},"issuer_ref":{"$ref":"#/$defs/ref"},"candidate_scope":{"type":"string","minLength":1}}},
    "independence":{"type":"object","additionalProperties":false,"required":["basis","conflict_disclosure","relationship_boundary","effective_interval","signed_scope_sha256"],"properties":{"basis":{"type":"string","minLength":1},"conflict_disclosure":{"enum":["none","declared"]},"relationship_boundary":{"type":"string","minLength":1},"effective_interval":{"$ref":"#/$defs/interval"},"signed_scope_sha256":{"$ref":"#/$defs/sha256"}}},
    "attestation_scope":{"type":"object","additionalProperties":false,"required":["layers","axis_ids","evidence_rows"],"properties":{"layers":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"contains":{"const":"G1"},"allOf":[{"contains":{"const":"G2"}},{"contains":{"const":"G3"}}],"items":{"enum":["G1","G2","G3"]}},"axis_ids":{"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"type":"string","minLength":1}},"evidence_rows":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence_row"}}}},
    "leaf_attestation":{"type":"object","additionalProperties":false,"required":["leaf_certificate_ref","canonical_preimage_sha256","signature_sha256","trusted_time_ref","revocation_ref","scope_sha256"],"properties":{"leaf_certificate_ref":{"$ref":"#/$defs/ref"},"canonical_preimage_sha256":{"$ref":"#/$defs/sha256"},"signature_sha256":{"$ref":"#/$defs/sha256"},"trusted_time_ref":{"$ref":"#/$defs/ref"},"revocation_ref":{"$ref":"#/$defs/ref"},"scope_sha256":{"$ref":"#/$defs/sha256"}}},
    "ack_binding":{"type":"object","additionalProperties":false,"required":["request_id","bundle_id","packet_id","payload_sha256","ack_scope_sha256"],"properties":{"request_id":{"$ref":"#/$defs/uuid"},"bundle_id":{"$ref":"#/$defs/uuid"},"packet_id":{"const":"EHP-01"},"payload_sha256":{"$ref":"#/$defs/sha256"},"ack_scope_sha256":{"$ref":"#/$defs/sha256"}}}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"uuid":{"type":"string","format":"uuid"},"ref":{"type":"object","additionalProperties":false,"required":["ref","sha256"],"properties":{"ref":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"}}},"interval":{"type":"object","additionalProperties":false,"required":["not_before","not_after"],"properties":{"not_before":{"type":"string","format":"date-time"},"not_after":{"type":"string","format":"date-time"}}},"evidence_row":{"type":"object","additionalProperties":false,"required":["evidence_id","kind","sha256","source_ref","candidate_id","issued_at","signature_ref"],"properties":{"evidence_id":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"},"source_ref":{"$ref":"#/$defs/ref"},"candidate_id":{"type":"string","minLength":1},"issued_at":{"type":"string","format":"date-time"},"signature_ref":{"$ref":"#/$defs/ref"}}}
  }
}

{
  "schema": "UP1.atomic-bundle.preimage-profile.v1",
  "canonicalization": "RFC8785-or-limited-ecmascript-safe-fallback",
  "domain_prefix": "UP1.external-handoff.atomic-response-bundle.v1/",
  "exclusions": [
    "signature", "signature_sha256", "owner_preimage_sha256",
    "set_signature", "set_preimage_sha256", "review_signature",
    "review_preimage_sha256", "bundle_canonical_sha256"
  ],
  "preimages": {
    "packet-owner": {"remove": ["signature", "signature_sha256", "owner_preimage_sha256", "payload_sha256"], "retain": ["payload"]},
    "set-receipt": {"remove": ["set_signature", "set_preimage_sha256"], "retain": ["packet_digests", "shared_binding", "bundle_canonical_sha256", "channel", "quarantine_receipt", "decision"]},
    "independent-review": {"remove": ["review_signature", "review_preimage_sha256"], "retain": ["recomputed_packet_digests", "recomputed_bundle_sha256", "set_receipt_sha256", "trust_outcome", "time_outcome", "revocation_outcome", "replay_outcome", "derived_decision"]},
    "bundle": {"remove": ["bundle_canonical_sha256", "signature", "signature_b64", "signature_sha256", "owner_preimage_sha256", "set_signature", "set_preimage_sha256", "review_signature", "review_preimage_sha256"], "retain": ["packet", "payload", "set_receipt", "independent_review"]}
  },
  "aliases_rejected": ["signature_digest", "payload_digest"],
  "non_authoritative": true
}

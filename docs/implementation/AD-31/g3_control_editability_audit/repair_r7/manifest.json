  "canonical_failure_check": {
    "before": "canonical_json(semantic_view(old_state)) and SHA256",
    "after": "canonical_json(semantic_view(result.state)) and SHA256",
    "required": "before and after bytes/digests equal; result.state===old_state where runtime identity is meaningful, otherwise exact serialized equality",
    "applies_to": "all failed operations, including forged refs, stale/foreign identity, malformed provenance, history transitions, non-mode/multi-fault and typed absence"
